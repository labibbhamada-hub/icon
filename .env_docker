PROJECT_NAME=icon

TZ=Asia/Jakarta

# =========================
# CONTAINER
# =========================

APP_CONTAINER_NAME=icon_app
NGINX_CONTAINER_NAME=icon_nginx
MYSQL_CONTAINER_NAME=icon_mysql

# =========================
# IMAGE
# =========================

PHP_VERSION=8.3
NGINX_VERSION=1.29-alpine
MYSQL_VERSION=8.4

# =========================
# MYSQL
# =========================

MYSQL_DATABASE=icon
MYSQL_USER=icon
MYSQL_PASSWORD=CHANGE_ME_ICON_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PORT=3306

MYSQL_VOLUME_NAME=icon_mysql_data

# =========================
# DOMAIN
# =========================

APP_DOMAIN=icon.bhamada.ac.id